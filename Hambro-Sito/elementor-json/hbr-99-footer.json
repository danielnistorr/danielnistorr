          "html": "<style>:root{--carta:#F2EDE4;--carta-2:#E8E1D5;--inchiostro:#1B1714;--grigio:#5E554C;--filo:rgba(27,23,20,.18);--cuoio:#7B4524;--campo:#6E3519;--campo-testo:#F2EDE4;--campo-tenue:#DCC4AE;--taglio:#3A2012;--oro:#E2B866;--m:clamp(20px,5vw,72px);--gap:24px;--k:1;--u:calc(1mm * var(--k))}@media (max-width:700px){:root{--gap:16px}}body{background:var(--carta)!important;overflow-x:hidden!important}:where(.hbr-piede),:where(.hbr-piede) *{margin:0!important;padding:0!important}:where(.hbr-piede) *,:where(.hbr-piede) *::before,:where(.hbr-piede) *::after{box-sizing:border-box!important}.hbr-piede{font-family:\"Mona Sans\",system-ui,sans-serif!important;font-size:17px!important;line-height:1.55!important;font-weight:400!important;font-stretch:100%!important;font-synthesis:none!important;font-variant-numeric:lining-nums!important;-webkit-font-smoothing:antialiased!important;color:var(--inchiostro)!important;text-align:left!important;text-transform:none!important;letter-spacing:normal!important;-webkit-text-size-adjust:100%!important;text-size-adjust:100%!important}:where(.hbr-piede) :is(.elementor-widget,.hbr-w,.e-con,.hbr-con){font:inherit!important;letter-spacing:inherit!important;text-transform:inherit!important;color:inherit!important;text-align:inherit!important;line-height:inherit!important;width:auto!important;max-width:none!important;min-height:0!important}:where(.hbr-piede) :is(h1,h2,h3,h4,.elementor-heading-title){font:inherit!important;font-weight:400!important;letter-spacing:inherit!important;text-transform:inherit!important;color:inherit!important;line-height:inherit!important;text-wrap:balance!important}:where(.hbr-piede) :is(p,li,dd,td){text-wrap:pretty!important}:where(.hbr-piede) li{list-style:none!important;border:0!important}:where(.hbr-piede) label{line-height:inherit!important;vertical-align:baseline!important}.hbr-piede img{display:block!important;max-width:100%!important;height:auto!important;border:0!important;border-radius:0!important;box-shadow:none!important}.hbr-piede a{color:inherit!important;text-decoration:underline!important;text-decoration-thickness:1px!important;text-underline-offset:.22em!important;box-shadow:none!important;transition:none!important;background:none!important}.hbr-piede a:hover{color:var(--cuoio)!important}.hbr-piede :focus-visible{outline:2px solid var(--cuoio)!important;outline-offset:3px!important;box-shadow:none!important}.hbr-piede .hbr-nascosto{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important}.hbr-cnt,.hbr-cnt>.elementor-widget,.hbr-cnt>.hbr-w{display:contents!important}.hbr-griglia{display:grid!important;grid-template-columns:repeat(12,minmax(0,1fr))!important;column-gap:var(--gap)!important;padding-inline:var(--m)!important;flex-wrap:nowrap!important}.hbr-didascalia{font-size:13px!important;line-height:1.45!important;color:var(--grigio)!important}.hbr-didascalia b{font-weight:600!important;color:var(--inchiostro)!important;margin-right:.35em!important}.hbr-h2,.hbr-h2 .elementor-heading-title{font-size:clamp(34px,4.3vw,60px)!important;line-height:1!important;letter-spacing:-.03em!important}.hbr-piede{background:var(--inchiostro)!important;color:#CFC6B8!important;padding:56px 0!important;font-size:15px!important;line-height:1.6!important;display:block!important;width:auto!important;max-width:none!important;margin:0!important}.hbr-piede .hbr-piede-marchio{grid-column:1/4!important;align-self:start!important}.hbr-piede-marchio,.hbr-piede-marchio .elementor-heading-title{font-stretch:125%!important;font-weight:640!important;font-size:22px!important;letter-spacing:.14em!important;line-height:1!important;color:var(--carta)!important}.hbr-piede .hbr-col{grid-column:span 3!important}.hbr-piede .hbr-col p{text-wrap:wrap!important}.hbr-piede a{text-decoration:none!important;color:inherit!important}.hbr-piede .hbr-piede-marchio a{color:var(--carta)!important}.hbr-piede a:hover,.hbr-piede .hbr-piede-marchio a:hover{color:var(--carta)!important;text-decoration:underline!important}@media (max-width:1100px){.hbr-piede .hbr-piede-marchio{grid-column:1/13!important;margin-bottom:24px!important}.hbr-piede .hbr-col{grid-column:span 4!important}}@media (max-width:700px){.hbr-piede .hbr-col{grid-column:1/13!important;margin-bottom:18px!important}}</style>"
