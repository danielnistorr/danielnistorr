      "html": "<style>\n.enc-ris{position:relative;min-height:100vh;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden;background:#0B0B0C}\n.enc-ris-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:30% 30%}\n.enc-ris-velo{position:absolute;inset:0;background:linear-gradient(to top,rgba(11,11,12,0.86) 0%,rgba(11,11,12,0.5) 50%,rgba(11,11,12,0.3) 100%)}\n.enc-ris-testo{position:relative;width:100%;display:flex;flex-direction:column;gap:32px;padding-top:160px;padding-bottom:96px}\n.enc-ris-testo .enc-label{color:rgba(255,255,255,0.78)}\n.enc-ris-testo .enc-big{color:#FFFFFF;max-width:19em;font-size:52px}\n@media (max-width:1024px){.enc-ris-testo .enc-big{font-size:40px}}\n@media (max-width:767px){.enc-ris{min-height:620px}.enc-ris-testo{padding-bottom:56px}.enc-ris-testo .enc-big{font-size:30px}}</style><div class=\"enc-ris\">\n<img class=\"enc-ris-img\" src=\"https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/result-knit-1600.webp\" srcset=\"https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/result-knit-900.webp 900w, https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/result-knit-1600.webp 1600w, https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/result-knit-2400.webp 2400w\" sizes=\"100vw\"\n width=\"1600\" height=\"900\" alt=\"A model wearing a neutral wool knit sweater\" loading=\"lazy\" decoding=\"async\">\n<div class=\"enc-ris-velo\"></div>\n<div class=\"enc-c enc-ris-testo\"><p class=\"enc-label\">The result</p>\n<p class=\"enc-t enc-big\">Your end-of-season stock stops being a cost and a risk, and becomes cheaper fibre for your next collection.</p></div>\n</div>"
