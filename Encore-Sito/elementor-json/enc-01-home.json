     "settings": {
      "html": "<style>\n.enc-cta{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch}\n.enc-cta-sx{display:flex;flex-direction:column;gap:64px}\n.enc-cta-foto{aspect-ratio:4/3}\n.enc-cta-modulo{background:#F5F5F3;border-radius:6px;padding:56px;display:flex;flex-direction:column;justify-content:center}\n.enc-form{display:flex;flex-direction:column;gap:32px;width:100%}\n.enc-campo{display:flex;flex-direction:column;gap:8px}\n.enc-input.enc-input{font-family:'Instrument Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:17px;line-height:1.5;color:#131316;background:transparent;border:0;\n  border-bottom:1px solid #CFCFCA;border-radius:0;padding:8px 0;width:100%;box-shadow:none}\n.enc-input.enc-input:focus{border-bottom-color:#131316;outline:none}\n.enc-input.enc-input:focus-visible{outline:2px solid #131316;outline-offset:4px}\ntextarea.enc-input.enc-input{resize:vertical;min-height:104px}\n.enc-form .enc-btn{margin-top:8px}\n.enc-grazie{font-size:44px;line-height:1.1;letter-spacing:-0.02em}\n.enc-form[hidden],.enc-grazie[hidden]{display:none}\n@media (max-width:900px){.enc-cta{grid-template-columns:1fr}.enc-cta-sx{gap:40px}.enc-cta-modulo{padding:32px 24px}}</style><div class=\"enc-c enc-sez\">\n<div class=\"enc-testa-sez\"><p class=\"enc-label\">Pilot</p><p class=\"enc-label\">Startup Generation Challenge Verona 2026</p></div>\n<div class=\"enc-cta\">\n<div class=\"enc-cta-sx\">\n<h2 class=\"enc-t enc-h2\">Start your first loop.</h2>\n<figure class=\"enc-fig enc-cta-foto\"><img src=\"https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/solution-wool-1400.webp\" srcset=\"https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/solution-wool-800.webp 800w, https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/solution-wool-1400.webp 1400w\" sizes=\"(max-width:900px) 100vw, 50vw\" width=\"1400\" height=\"1750\" alt=\"Close-up of cable knit wool\" decoding=\"async\" loading=\"lazy\"></figure>\n</div>\n<div class=\"enc-cta-modulo\">\n<form class=\"enc-form\" id=\"enc-form\" novalidate>\n<label class=\"enc-campo\" for=\"enc-name\"><span class=\"enc-label\">Name</span><input class=\"enc-input enc-input\" id=\"enc-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required></label><label class=\"enc-campo\" for=\"enc-brand\"><span class=\"enc-label\">Brand</span><input class=\"enc-input enc-input\" id=\"enc-brand\" name=\"brand\" type=\"text\" autocomplete=\"organization\" required></label><label class=\"enc-campo\" for=\"enc-email\"><span class=\"enc-label\">Email</span><input class=\"enc-input enc-input\" id=\"enc-email\" name=\"email\" type=\"email\" autocomplete=\"email\" required></label>\n<label class=\"enc-campo\" for=\"enc-message\"><span class=\"enc-label\">Message</span><textarea class=\"enc-input enc-input\" id=\"enc-message\" name=\"message\" rows=\"4\"></textarea></label>\n<div><button class=\"enc-btn enc-btn\" type=\"submit\">Book a pilot</button></div>\n</form>\n<p class=\"enc-t enc-grazie\" id=\"enc-grazie\" tabindex=\"-1\" hidden>Thank you.</p>\n</div>\n</div>\n</div>\n<script>(function(){var f=document.getElementById('enc-form'),g=document.getElementById('enc-grazie');if(!f)return;\nf.addEventListener('submit',function(e){e.preventDefault();if(!f.checkValidity()){f.reportValidity();return;}\nf.hidden=true;g.hidden=false;g.focus();});})();</script>"
