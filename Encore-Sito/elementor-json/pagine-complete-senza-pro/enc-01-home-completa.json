      "html": "<style>\n.enc-due{display:grid;grid-template-columns:1fr 1fr;align-items:stretch}\n.enc-due-testo{display:flex;flex-direction:column;justify-content:center;gap:32px;color:#151412}\n.enc-due-testo .enc-h2{max-width:11em}\n.enc-due-foto{min-height:720px}\n.enc-due-foto-sx .enc-due-testo{padding-left:96px}\n.enc-due-foto-dx .enc-due-testo{padding-right:96px}\n@media (max-width:1024px){.enc-due-foto-sx .enc-due-testo{padding-left:48px}.enc-due-foto-dx .enc-due-testo{padding-right:48px}}\n@media (max-width:900px){\n  .enc-due{grid-template-columns:1fr}\n  .enc-due-foto{min-height:0;aspect-ratio:3/2;order:2}\n  .enc-due-foto-sx .enc-due-testo,.enc-due-foto-dx .enc-due-testo{padding-left:40px;padding-right:40px}\n}\n@media (max-width:767px){\n  .enc-due-foto-sx .enc-due-testo,.enc-due-foto-dx .enc-due-testo{padding-left:16px;padding-right:16px}\n  .enc-due-foto{aspect-ratio:4/5}\n}\n.enc-form{display:flex;flex-direction:column;gap:24px;width:100%;max-width:520px}\n.enc-campo{display:flex;flex-direction:column;gap:8px;color:#151412}\n.enc-input.enc-input{font-family:'Jost',Arial,sans-serif;font-size:17px;line-height:1.5;color:#151412;background:transparent;\n  border:0;border-bottom:1px solid #8C857B;border-radius:0;padding:8px 0;width:100%;box-shadow:none;outline-offset:4px}\n.enc-input.enc-input:focus{border-bottom-color:#151412}\ntextarea.enc-input.enc-input{resize:vertical;min-height:96px}\n.enc-form .enc-btn{margin-top:16px}\n.enc-grazie{font-size:40px;line-height:1.1;color:#151412;margin:0}\n.enc-form[hidden],.enc-grazie[hidden]{display:none}</style><div class=\"enc-due enc-due-foto-sx\">\n<figure class=\"enc-fig enc-due-foto\"><img src=\"https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/cta-wool-macro-1400.webp\" srcset=\"https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/cta-wool-macro-800.webp 800w, https://raw.githubusercontent.com/danielnistorr/danielnistorr/claude/benvegnu-sito/Encore-Sito/assets/web/cta-wool-macro-1400.webp 1400w\" sizes=\"(max-width:900px) 100vw, 50vw\" width=\"1400\" height=\"1750\" alt=\"Macro photograph of woven wool\" decoding=\"async\" loading=\"lazy\"></figure>\n<div class=\"enc-due-testo enc-in enc-sez\">\n<h2 class=\"enc-serif enc-h2\">Start your first loop.</h2>\n<form class=\"enc-form\" id=\"enc-form\" novalidate>\n<label class=\"enc-campo\"><span class=\"enc-label\">Name</span><input class=\"enc-input enc-input\" name=\"name\" type=\"text\" autocomplete=\"name\" required></label><label class=\"enc-campo\"><span class=\"enc-label\">Brand</span><input class=\"enc-input enc-input\" name=\"brand\" type=\"text\" autocomplete=\"organization\" required></label><label class=\"enc-campo\"><span class=\"enc-label\">Email</span><input class=\"enc-input enc-input\" name=\"email\" type=\"email\" autocomplete=\"email\" required></label>\n<label class=\"enc-campo\"><span class=\"enc-label\">Message</span><textarea class=\"enc-input enc-input\" name=\"message\" rows=\"4\"></textarea></label>\n<div><button class=\"enc-btn enc-btn\" type=\"submit\">Book a pilot</button></div>\n</form>\n<p class=\"enc-serif enc-grazie\" id=\"enc-grazie\" tabindex=\"-1\" hidden>Thank you.</p>\n</div>\n</div>\n<script>(function(){var f=document.getElementById('enc-form'),g=document.getElementById('enc-grazie');if(!f)return;\nf.addEventListener('submit',function(e){e.preventDefault();if(!f.checkValidity()){f.reportValidity();return;}\nf.hidden=true;g.hidden=false;g.focus();});})();</script>"
