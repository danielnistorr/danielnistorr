        "html": "<details class=\"mag-menu\"><summary>Menu</summary><ul><li><a href=\"/#lavorazioni\">Lavorazioni</a></li><li><a href=\"/#serie\">Dal disegno alla serie</a></li><li><a href=\"/#punzoni\">Punzoni</a></li><li><a href=\"/#contatti\">Dove siamo</a></li></ul></details><script>(function(){var menu=document.querySelector('.mag-menu');if(!menu)return;var fonte=document.querySelector('.mag-nav ul');var ul=menu.querySelector('ul');if(fonte&&ul){var v=fonte.querySelectorAll('a');if(v.length){ul.innerHTML='';v.forEach(function(x){var li=document.createElement('li'),a=document.createElement('a');a.href=x.getAttribute('href');a.textContent=x.textContent.trim();li.appendChild(a);ul.appendChild(li)})}}menu.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){menu.open=false})});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&menu.open){menu.open=false;menu.querySelector('summary').focus()}});document.addEventListener('click',function(e){if(menu.open&&!menu.contains(e.target))menu.open=false})})();</script>"
