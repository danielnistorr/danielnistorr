    "widgetType": "text-editor",
    "isInner": false,
    "settings": {
     "editor": "<p>WordPress, il programma che fa funzionare il sito, usa cookie tecnici solo per chi entra nell'area riservata (gli amministratori). Chi visita le pagine non li riceve.</p>"
    },
